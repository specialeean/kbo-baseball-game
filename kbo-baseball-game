      if (['single', 'double', 'homerun'].includes(k)) {
        m *= (1.5 - (stamina / 100)); 
      } else if (['strike_swinging', 'strike_looking'].includes(k)) {
        m *= (0.5 + (stamina / 100)); 
      }
    }
    const weight = w*m;
    total += weight;
    items.push([k, weight]);
  }
  let r = Math.random()*total;
  for(const [k,w] of items){ if(r<w) return k; r-=w; }
  return items[items.length-1][0];
}
function pick(arr){ return arr[Math.floor(Math.random()*arr.length)]; }

