<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>2026 KBO 야구 게임 마스터</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<style>
  :root{
    --night:#050e0b;
    --grass:#113324;
    --grass2:#1a4532;
    --dirt:#a9764e;
    --chalk:#f8f5ec;
    --lights:#ffce54;
    --lights-dim:#7a6733;
    --away:#ff5252;
    --home:#40c4ff;
    --panel:rgba(12, 32, 26, 0.88);
    --line:rgba(255, 255, 255, 0.12);
    --team-accent:#ffce54;
    --team-glow:rgba(255, 206, 84, 0.4);
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    overflow-x:hidden;
    background:
      radial-gradient(circle at 50% -20%, var(--team-glow), transparent 70%),
      linear-gradient(180deg, var(--night), #020705 100%);
    color:var(--chalk);
    font-family:'Segoe UI', 'Malgun Gothic', -apple-system, sans-serif;
    min-height:100vh;
    display:flex;
    align-items:flex-start;
    justify-content:center;
    padding:20px 10px 50px;
    transition: background 0.5s ease;
  }
  .wrap{
    width:100%;
    max-width:680px;
    margin:0 auto;
  }
  h1.title{
    font-family:'Arial Narrow', 'Malgun Gothic', sans-serif;
    font-weight:900;
    letter-spacing:3px;
    text-transform:uppercase;
    font-size:26px;
    text-align:center;
    color:var(--team-accent);
    margin:0 0 4px;
    text-shadow:0 0 20px var(--team-glow), 0 2px 4px rgba(0,0,0,0.8);
    transition: color 0.4s, text-shadow 0.4s;
  }
  .subtitle{
    text-align:center;
    font-size:12px;
    color:rgba(242,237,225,0.7);
    letter-spacing:1.5px;
    margin-bottom:20px;
    text-shadow:0 1px 2px rgba(0,0,0,0.8);
  }

  .card{
    background:var(--panel);
    backdrop-filter:blur(16px);
    border:1px solid var(--team-accent);
    border-radius:20px;
    padding:22px;
    box-shadow:0 25px 50px -12px rgba(0,0,0,0.9), 0 0 25px var(--team-glow);
    transition: border-color 0.4s, box-shadow 0.4s;
  }
  .field-row{margin-bottom:16px;}
  .field-row label{
    display:block;
    font-size:11px;
    font-weight:700;
    letter-spacing:1.5px;
    text-transform:uppercase;
    color:rgba(242,237,225,0.75);
    margin-bottom:6px;
  }
  .select-group{
    display:flex;
    align-items:center;
    gap:12px;
  }
  .team-logo-badge{
    width:46px;
    height:46px;
    flex-shrink:0;
    border-radius:50%;
    background:rgba(0,0,0,0.5);
    padding:5px;
    border:2px solid var(--team-accent);
    display:flex;
    align-items:center;
    justify-content:center;
    box-shadow:0 0 12px var(--team-glow);
  }
  .team-logo-badge svg{
    width:100%;
    height:100%;
  }
  select{
    flex:1;
    padding:12px 14px;
    background:#081712;
    border:1px solid var(--line);
    border-radius:10px;
    color:var(--chalk);
    font-size:15px;
    font-weight:700;
    outline:none;
    box-shadow:inset 0 2px 4px rgba(0,0,0,0.5);
  }

  .stadium-preview-card{
    margin:16px 0 20px;
    padding:16px;
    background:linear-gradient(135deg, rgba(0,0,0,0.6), rgba(8,24,18,0.8));
    border-radius:14px;
    border:1px solid var(--team-accent);
    display:flex;
    align-items:center;
    gap:16px;
    box-shadow:0 8px 20px rgba(0,0,0,0.6), inset 0 0 15px var(--team-glow);
  }
  .stadium-icon{
    font-size:32px;
    width:52px;
    height:52px;
    border-radius:12px;
    background:rgba(255,255,255,0.06);
    border:1px solid rgba(255,255,255,0.1);
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
  }
  .stadium-info-text{
    flex:1;
  }
  .stadium-title{
    font-size:16px;
    font-weight:900;
    color:var(--team-accent);
    margin-bottom:4px;
    text-shadow:0 0 10px var(--team-glow);
  }
  .stadium-desc{
    font-size:12px;
    color:rgba(242,237,225,0.8);
    line-height:1.45;
  }

  .lineup-preview{
    margin-top:8px;
    font-size:12px;
    color:rgba(242,237,225,0.7);
    line-height:1.6;
    padding:10px 12px;
    background:rgba(0,0,0,0.35);
    border-radius:8px;
    border-left:4px solid var(--team-accent);
  }
  .lineup-preview b{color:var(--team-accent);}
  
  button.primary{
    width:100%;
    margin-top:10px;
    padding:16px;
    border:none;
    border-radius:12px;
    background:linear-gradient(180deg, #ffffff 0%, var(--team-accent) 100%);
    color:#050e0b;
    font-weight:900;
    font-size:17px;
    letter-spacing:1px;
    cursor:pointer;
    box-shadow:0 10px 25px -5px var(--team-glow);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  button.primary:hover{
    transform:translateY(-2px);
    box-shadow:0 14px 30px -4px var(--team-glow);
  }
  button.primary:active{transform:translateY(1px);}
  .vs-badge{
    text-align:center;
    font-size:12px;
    letter-spacing:4px;
    color:rgba(242,237,225,0.4);
    margin:6px 0 16px;
    font-weight:800;
  }

  #gameScreen{display:none;}
  .scoreboard{
    background:linear-gradient(180deg,rgba(10,28,22,0.95),rgba(5,15,12,0.98));
    border:1px solid var(--team-accent);
    border-radius:16px;
    padding:18px;
    margin-bottom:16px;
    box-shadow:0 15px 35px rgba(0,0,0,0.8), 0 0 15px var(--team-glow);
  }
  .sb-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:12px;
  }
  .inning-tag{
    font-size:13px;
    font-weight:800;
    letter-spacing:1px;
    color:var(--team-accent);
    background:rgba(255,206,84,0.12);
    padding:5px 12px;
    border-radius:20px;
    border:1px solid rgba(255,206,84,0.25);
  }
  .teams-score{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin:8px 0 14px;
  }
  .team-block{
    flex:1;
    display:flex;
    flex-direction:column;
    align-items:center;
  }
  .team-header-row{
    display:flex;
    align-items:center;
    gap:6px;
  }
  .sb-logo-mini{
    width:24px;
    height:24px;
  }
  .team-name{
    font-size:14px;
    font-weight:800;
    letter-spacing:0.5px;
    color:rgba(242,237,225,0.95);
  }
  .team-block.away .team-name{color:#ff7b72;}
  .team-block.home .team-name{color:#79c0ff;}
  .team-score{
    font-family:'Courier New', monospace;
    font-size:40px;
    font-weight:900;
    line-height:1.1;
    margin-top:2px;
    text-shadow:0 0 10px rgba(255,255,255,0.2);
  }
  .score-sep{font-size:22px;color:rgba(242,237,225,0.3);font-weight:300;}

  .pitcher-status-bar{
    display:flex; 
    justify-content:space-between; 
    padding:8px 12px; 
    background:rgba(0,0,0,0.4); 
    border-radius:10px; 
    margin-bottom:12px; 
    font-size:12px; 
    border:1px solid rgba(255,255,255,0.08);
  }

  .runners-panel{
    display:flex;
    justify-content:space-around;
    align-items:center;
    background:rgba(0, 0, 0, 0.45);
    border:1px solid var(--team-accent);
    border-radius:10px;
    padding:10px;
    margin-bottom:12px;
    font-size:12.5px;
    box-shadow:inset 0 0 10px rgba(0,0,0,0.6);
  }
  .runner-item{
    display:flex;
    align-items:center;
    gap:6px;
  }
  .runner-badge{
    width:22px;
    height:22px;
    line-height:22px;
    text-align:center;
    border-radius:5px;
    font-weight:900;
    font-size:11px;
    background:#1c2d26;
    color:rgba(242,237,225,0.4);
    border:1px solid rgba(255,255,255,0.1);
  }
  .runner-badge.active{
    background:var(--team-accent);
    color:#000;
    box-shadow:0 0 10px var(--team-glow);
    border-color:var(--team-accent);
  }
  .runner-name{
    font-weight:700;
    color:rgba(242,237,225,0.95);
  }

  .status-row{
    display:flex;
    gap:16px;
    align-items:center;
    justify-content:center;
    flex-wrap:wrap;
    margin-bottom:14px;
  }
  .pips-group{display:flex;align-items:center;gap:6px;}
  .pips-label{font-size:11px;font-weight:800;color:rgba(242,237,225,0.6);letter-spacing:1px;}
  .pip{
    width:12px;height:12px;border-radius:50%;
    border:1.5px solid rgba(242,237,225,0.3);
  }
  .pip.filled-ball{background:#00e676;border-color:#00e676;box-shadow:0 0 6px #00e676;}
  .pip.filled-strike{background:var(--lights);border-color:var(--lights);box-shadow:0 0 6px var(--lights);}
  .pip.filled-out{background:var(--away);border-color:var(--away);box-shadow:0 0 6px var(--away);}

  .diamond-wrap{
    width:100%;
    height:390px;
    margin-bottom:14px;
    border:1px solid var(--team-accent);
    border-radius:14px;
    overflow:hidden;
    background:#020806;
    display:flex; 
    box-shadow:0 10px 25px rgba(0,0,0,0.8), inset 0 0 20px rgba(0,0,0,0.9);
  }
  #threeContainer{
    flex:1;
    height:100%;
    position:relative;
    overflow:hidden;
  }
  #threeContainer canvas {
    position:absolute;
    top:0;
    left:0;
    width:100% !important;
    height:100% !important;
    display:block;
  }
  
  .camera-controls{
    position:absolute;
    top:10px;
    left:10px;
    z-index:15;
    display:flex;
    gap:6px;
  }
  .cam-btn{
    background:rgba(5, 15, 12, 0.85);
    border:1px solid var(--team-accent);
    color:var(--chalk);
    padding:5px 9px;
    font-size:11px;
    font-weight:800;
    border-radius:6px;
    cursor:pointer;
    backdrop-filter:blur(6px);
    transition:all 0.2s ease;
  }
  .cam-btn.active, .cam-btn:hover{
    background:var(--team-accent);
    color:#000;
    box-shadow:0 0 10px var(--team-glow);
  }

  /* ABS 방송용 세로 비율 존 패널 */
  .abs-panel{
    width:130px;
    height:100%;
    background:linear-gradient(180deg, #050d0a, #020705);
    border-left:1px solid var(--line);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    padding:10px 6px;
    flex-shrink:0;
  }
  .abs-title{
    font-size:11px;
    font-weight:900;
    letter-spacing:1.5px;
    color:var(--team-accent);
    margin-bottom:8px;
    text-transform:uppercase;
    text-shadow:0 0 8px var(--team-glow);
  }
  #absCanvas{
    background:#010504;
    border:1px solid rgba(255,206,84,0.35);
    border-radius:6px;
    box-shadow:inset 0 0 12px rgba(0,0,0,0.95);
  }
  .abs-info{
    font-size:10px;
    color:rgba(242,237,225,0.8);
    margin-top:10px;
    text-align:center;
    line-height:1.35;
    min-height:30px;
  }

  .commentary{
    background:rgba(0,0,0,0.3);
    border-left:4px solid var(--team-accent);
    border-radius:8px;
    padding:12px 14px;
    font-size:14px;
    font-weight:600;
    line-height:1.5;
    min-height:46px;
    margin-bottom:6px;
  }
  .log-mini{
    font-size:11.5px;
    color:rgba(242,237,225,0.45);
    padding:0 4px 4px;
    max-height:56px;
    overflow-y:auto;
  }

  .action-panel{
    background:var(--panel);
    backdrop-filter:blur(16px);
    border:1px solid var(--team-accent);
    border-radius:16px;
    padding:20px;
    box-shadow:0 15px 35px rgba(0,0,0,0.8);
  }
  .role-tag{
    font-size:12px;
    letter-spacing:1.5px;
    text-transform:uppercase;
    color:var(--team-accent);
    margin-bottom:6px;
    font-weight:800;
    text-shadow:0 0 8px var(--team-glow);
  }
  .role-desc{
    font-size:14px;
    color:rgba(242,237,225,0.9);
    margin-bottom:16px;
    line-height:1.5;
  }
  .role-desc b{color:var(--chalk);}
  .choice-btn{
    display:block;
    width:100%;
    text-align:left;
    padding:13px 16px;
    margin-bottom:10px;
    background:linear-gradient(90deg, #0b1f1a, #0d2821);
    border:1px solid var(--line);
    border-radius:10px;
    color:var(--chalk);
    font-size:14.5px;
    font-weight:600;
    cursor:pointer;
    transition:background 0.2s, border-color 0.2s, transform 0.1s, box-shadow 0.2s;
  }
  .choice-btn:hover{
    background:linear-gradient(90deg, #12332a, #163d32);
    border-color:var(--team-accent);
    box-shadow:0 4px 15px var(--team-glow);
  }
  .choice-btn:active{transform:scale(0.98);}
  .choice-num{
    display:inline-block;
    width:22px;height:22px;
    line-height:22px;
    text-align:center;
    border-radius:50%;
    background:var(--team-accent);
    color:#000;
    font-weight:900;
    font-size:12px;
    margin-right:12px;
  }

  #endScreen{display:none;text-align:center;}
  .end-title{font-size:28px;font-weight:900;color:var(--team-accent);margin-bottom:6px;text-shadow:0 0 15px var(--team-glow);}
  .end-sub{font-size:14px;color:rgba(242,237,225,0.8);margin-bottom:22px;}
  .final-score{
    font-family:'Courier New',monospace;
    font-size:36px;font-weight:900;
    margin-bottom:24px;
  }
  button.secondary{
    padding:14px 26px;
    border:2px solid var(--team-accent);
    background:transparent;
    color:var(--team-accent);
    border-radius:10px;
    font-weight:800;
    font-size:15px;
    cursor:pointer;
    transition:background 0.2s;
  }
  button.secondary:hover{
    background:var(--team-accent);
    color:#000;
  }
</style>
</head>
<body>
<div class="wrap">
  <h1 class="title">⚾ KBO 야구 게임 마스터</h1>
  <div class="subtitle">2026 프로시즌 · 구단별 공식 로고 및 홈구장 비주얼 테마 연동</div>

  <div id="selectScreen" class="card">
    <div class="field-row">
      <label>플레이어 팀 (홈 · 1회말 공격)</label>
      <div class="select-group">
        <div class="team-logo-badge" id="homeLogoBadge"></div>
        <select id="homeSelect"></select>
      </div>
      <div class="lineup-preview" id="homePreview"></div>
    </div>

    <div class="stadium-preview-card">
      <div class="stadium-icon" id="stadiumIcon">🏟️</div>
      <div class="stadium-info-text">
        <div class="stadium-title" id="stadiumTitle">홈구장 선택 중...</div>
        <div class="stadium-desc" id="stadiumDesc">플레이어 팀의 전용 구장 3D 모델 및 구단 상징색 테마가 설정됩니다.</div>
      </div>
    </div>

    <div class="field-row" style="margin-top:10px;">
      <label>플레이어 등판 선발 투수 선택 (1~5선발)</label>
      <select id="pitcherSelect"></select>
    </div>

    <div class="vs-badge">V S</div>

    <div class="field-row">
      <label>원정 팀 (AI · 1회초 공격)</label>
      <div class="select-group">
        <div class="team-logo-badge" id="awayLogoBadge"></div>
        <select id="awaySelect"></select>
      </div>
      <div class="lineup-preview" id="awayPreview"></div>
    </div>

    <button class="primary" id="startBtn">경기 시작 ▶ 1회초</button>
  </div>

  <div id="gameScreen">
    <div class="scoreboard">
      <div class="sb-top">
        <span class="inning-tag" id="inningTag">1회초</span>
        <span class="inning-tag" id="halfTag">원정 공격 · 플레이어 수비</span>
      </div>
      <div class="teams-score">
        <div class="team-block away">
          <div class="team-header-row">
            <div class="sb-logo-mini" id="sbAwayLogo"></div>
            <div class="team-name" id="awayNameTag">원정</div>
          </div>
          <div class="team-score" id="awayScoreTag">0</div>
        </div>
        <div class="score-sep">–</div>
        <div class="team-block home">
          <div class="team-header-row">
            <div class="sb-logo-mini" id="sbHomeLogo"></div>
            <div class="team-name" id="homeNameTag">홈</div>
          </div>
          <div class="team-score" id="homeScoreTag">0</div>
        </div>
      </div>

      <div class="pitcher-status-bar">
        <div>🔴 투수: <b id="awayPitcherTag" style="color:#ff7b72;">투수</b> (<span id="awayStaminaTag" style="font-weight:700;">100%</span>, 투구수: <span id="awayPitchesTag" style="font-weight:700; color:#ffdd7a;">0</span>)</div>
        <div>🔵 투수: <b id="homePitcherTag" style="color:#79c0ff;">투수</b> (<span id="homeStaminaTag" style="font-weight:700;">100%</span>, 투구수: <span id="homePitchesTag" style="font-weight:700; color:#ffdd7a;">0</span>)</div>
      </div>

      <div class="runners-panel">
        <div class="runner-item">
          <div class="runner-badge" id="b1Badge">1B</div>
          <span class="runner-name" id="b1Name">비어있음</span>
        </div>
        <div class="runner-item">
          <div class="runner-badge" id="b2Badge">2B</div>
          <span class="runner-name" id="b2Name">비어있음</span>
        </div>
        <div class="runner-item">
          <div class="runner-badge" id="b3Badge">3B</div>
          <span class="runner-name" id="b3Name">비어있음</span>
        </div>
      </div>

      <div class="status-row">
        <div class="pips-group">
          <span class="pips-label">B</span>
          <div class="pip" id="ball0"></div><div class="pip" id="ball1"></div><div class="pip" id="ball2"></div>
        </div>
        <div class="pips-group">
          <span class="pips-label">S</span>
          <div class="pip" id="strike0"></div><div class="pip" id="strike1"></div>
        </div>
        <div class="pips-group">
          <span class="pips-label">OUT</span>
          <div class="pip" id="out0"></div><div class="pip" id="out1"></div>
        </div>
      </div>
      
      <div class="diamond-wrap">
        <div id="threeContainer">
          <div class="camera-controls">
            <button class="cam-btn active" id="camBroadcastBtn" onclick="setCameraView('broadcast')">🎥 방송 시점</button>
            <button class="cam-btn" id="camPitcherBtn" onclick="setCameraView('pitcher')">⚾ 투수 시점</button>
            <button class="cam-btn" id="camCatcherBtn" onclick="setCameraView('catcher')">🧤 포수 시점</button>
          </div>
        </div>
        <div class="abs-panel">
          <div class="abs-title">ABS 존</div>
          <canvas id="absCanvas" width="110" height="150"></canvas>
          <div class="abs-info" id="absInfo">판정 대기 중</div>
        </div>
      </div>

      <div class="commentary" id="commentary">경기가 곧 시작됩니다...</div>
      <div class="log-mini" id="logMini"></div>
    </div>

    <div class="action-panel">
      <div class="role-tag" id="roleTag">투구 선택</div>
      <div class="role-desc" id="roleDesc"></div>
      <div id="choiceButtons"></div>
    </div>
  </div>

  <div id="endScreen" class="card">
    <div class="end-title" id="endTitle">경기 종료</div>
    <div class="end-sub" id="endSub"></div>
    <div class="final-score" id="finalScore"></div>
    <button class="secondary" id="restartBtn">팀 다시 선택하기</button>
  </div>
</div>

<script>
let audioCtx = null;

function initAudio() {
  if (!audioCtx) {
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  }
  if (audioCtx.state === 'suspended') {
    audioCtx.resume();
  }
}

function playSound(type) {
  try {
    initAudio();
    if (!audioCtx) return;
    const now = audioCtx.currentTime;

    if (type === 'pitch') {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(320, now);
      osc.frequency.exponentialRampToValueAtTime(110, now + 0.35);
      gain.gain.setValueAtTime(0.12, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.start(now); osc.stop(now + 0.35);
    } 
    else if (type === 'catch') {
      const bufferSize = audioCtx.sampleRate * 0.08;
      const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (audioCtx.sampleRate * 0.012));
      }
      const noise = audioCtx.createBufferSource();
      noise.buffer = buffer;
      const filter = audioCtx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.value = 650;
      const noiseGain = audioCtx.createGain();
      noiseGain.gain.setValueAtTime(0.5, now);
      noiseGain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
      noise.connect(filter); filter.connect(noiseGain); noiseGain.connect(audioCtx.destination);
      noise.start(now);
    } 
    else if (type === 'hit') {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(850, now);
      osc.frequency.exponentialRampToValueAtTime(180, now + 0.15);
      gain.gain.setValueAtTime(0.7, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.start(now); osc.stop(now + 0.15);

      const bufferSize = audioCtx.sampleRate * 0.04;
      const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
      const noise = audioCtx.createBufferSource();
      noise.buffer = buffer;
      const noiseGain = audioCtx.createGain();
      noiseGain.gain.setValueAtTime(0.6, now);
      noiseGain.gain.exponentialRampToValueAtTime(0.001, now + 0.04);
      noise.connect(noiseGain); noiseGain.connect(audioCtx.destination);
      noise.start(now);
    } 
    else if (type === 'homerun') {
      playSound('hit');
      setTimeout(() => playSound('cheer'), 120);
    } 
    else if (type === 'cheer') {
      const dur = 2.2;
      const bufferSize = audioCtx.sampleRate * dur;
      const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) data[i] = (Math.random() * 2 - 1);
      const noise = audioCtx.createBufferSource();
      noise.buffer = buffer;
      const filter = audioCtx.createBiquadFilter();
      filter.type = 'bandpass';
      filter.frequency.setValueAtTime(550, now);
      filter.Q.value = 1.8;
      const noiseGain = audioCtx.createGain();
      noiseGain.gain.setValueAtTime(0.01, now);
      noiseGain.gain.linearRampToValueAtTime(0.3, now + 0.5);
      noiseGain.gain.exponentialRampToValueAtTime(0.001, now + dur);
      noise.connect(filter); filter.connect(noiseGain); noiseGain.connect(audioCtx.destination);
      noise.start(now);
    } 
    else if (type === 'strike') {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(480, now);
      osc.frequency.setValueAtTime(680, now + 0.08);
      gain.gain.setValueAtTime(0.18, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.start(now); osc.stop(now + 0.22);
    } 
    else if (type === 'ball') {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(240, now);
      gain.gain.setValueAtTime(0.15, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.start(now); osc.stop(now + 0.18);
    }
  } catch(e) {}
}

