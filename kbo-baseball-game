function start3DAnimation(outcome, callback, pitchChoice = 3) {
  if (!renderer) {
    callback();
    return;
  }

  playSound('pitch');
  resetBallTrail();
  updateABS(null, null, null);

  const currentPitcherObj = isPlayerPitching() ? getActivePitcher('home') : getActivePitcher('away');
  const baseSpeed = currentPitcherObj.speed;
  const pitcherStamina = isPlayerPitching() ? state.pitchersStamina.home[state.activePitcherKey.home] : state.pitchersStamina.away[state.activePitcherKey.away];
  
  let staminaSpeedLoss = 0;
  if (pitcherStamina < 50) {
    staminaSpeedLoss = Math.floor((50 - pitcherStamina) * 0.18); 
  }

  const pitchTypesArr = currentPitcherObj.type.split('/');
  let pType = pitchTypesArr[0]; 
  let pSpeed = baseSpeed - staminaSpeedLoss;

  if (pitchChoice === 1) {
    pType = pitchTypesArr[0] || '포심';
    pSpeed += Math.floor(-2 + Math.random() * 5);
  } else if (pitchChoice === 2) {
    pType = pitchTypesArr[1] || pitchTypesArr[0] || '변화구';
    pSpeed -= Math.floor(10 + Math.random() * 12);
  } else {
    pType = pitchTypesArr[0] || '포심';
    pSpeed += Math.floor(Math.random() * 3);
  }

  animState.pitchType = pType;
  animState.pitchSpeed = pSpeed;

  const choiceBox = document.getElementById('choiceButtons');
  if (choiceBox) {
    choiceBox.style.pointerEvents = 'none';
    choiceBox.style.opacity = '0.35';
  }

  const isStrike = ['strike_looking', 'strike_swinging', 'foul', 'out', 'single', 'double', 'triple', 'homerun'].includes(outcome);
  let px = 0;
  let py = 0.85;

  if (isStrike) {
    // ABS 세로 직사각형 존 내부 좌표 (X: -0.21 ~ +0.21, Y: 0.55 ~ 1.15)
    px = (Math.random() - 0.5) * 0.42; 
    py = 0.55 + Math.random() * 0.60;  
  } else {
    // ABS 존 외부 좌표 (볼)
    const borderChoice = Math.floor(Math.random() * 4);
    if (borderChoice === 0) { 
      px = -0.32 - Math.random() * 0.20; py = 0.45 + Math.random() * 0.80;
    } else if (borderChoice === 1) { 
      px = 0.32 + Math.random() * 0.20; py = 0.45 + Math.random() * 0.80;
    } else if (borderChoice === 2) { 
      px = (Math.random() - 0.5) * 0.5; py = 1.28 + Math.random() * 0.20;
    } else { 
      px = (Math.random() - 0.5) * 0.5; py = 0.20 + Math.random() * 0.20;
    }
  }

  animState.pitchX = px;
  animState.pitchY = py;

  animState.active = true;
  animState.phase = 'pitching';
  animState.time = 0;
  animState.duration = 0.55; 
  animState.outcome = outcome;
  animState.onComplete = callback;

  animState.startPos.set(0, 1.35, 0);
  animState.endPos.set(px, py, 12); 

  animState.activeFielderKey = null;
  animState.playType = 'none';

  updateStaticRunners();
  updateTeamColors();
}

function update3D(deltaTime) {
  if (!animState.active) {
    camera.position.lerp(targetCamPos, 0.08);
    currentCamLook.lerp(targetCamLook, 0.08);
    camera.lookAt(currentCamLook);
    return;
  }

  animState.time += deltaTime;
  let t = Math.min(animState.time / animState.duration, 1);

  if (animState.phase === 'pickoff') {
    const p0 = animState.startPos;
    const p1 = animState.controlPos;
    const p2 = animState.endPos;
    ball.position.x = (1 - t) * (1 - t) * p0.x + 2 * (1 - t) * t * p1.x + t * t * p2.x;
    ball.position.y = (1 - t) * (1 - t) * p0.y + 2 * (1 - t) * t * p1.y + t * t * p2.y;
    ball.position.z = (1 - t) * (1 - t) * p0.z + 2 * (1 - t) * t * p1.z + t * t * p2.z;
    addBallTrailPoint(ball.position);

    if (animState.activeFielderKey) {
      const fMesh = fieldersMap[animState.activeFielderKey].mesh;
      fMesh.position.lerpVectors(animState.fielderStartPos, animState.fielderEndPos, t);
      fMesh.rotation.z = Math.sin(t * Math.PI) * 0.4;
    }

    if (t >= 1) completeAnimation();
    return;
  }

  if (animState.phase === 'bunt_pitch') {
    ball.position.lerpVectors(animState.startPos, animState.endPos, t);
    addBallTrailPoint(ball.position);

    if (t >= 1) {
      animState.phase = 'bunt_roll';
      animState.time = 0;
      animState.duration = 1.0;

      animState.startPos.set(0, 0.85, 12);
      animState.endPos.set((Math.random() - 0.5) * 4, 0.1, 7 + Math.random() * 3);

      const isPitcherFielding = Math.random() < 0.5;
      animState.activeFielderKey = isPitcherFielding ? 'P' : 'C';

      if (isPitcherFielding) {
        animState.fielderStartPos.copy(pitcherMesh.position);
      } else {
        animState.fielderStartPos.copy(catcherMesh.position);
      }
      animState.fielderEndPos.copy(animState.endPos);
    }
    return;
  }

  if (animState.phase === 'bunt_roll') {
    ball.position.lerpVectors(animState.startPos, animState.endPos, t);
    addBallTrailPoint(ball.position);

    const defenderMesh = animState.activeFielderKey === 'P' ? pitcherMesh : catcherMesh;
    defenderMesh.position.lerpVectors(animState.fielderStartPos, animState.fielderEndPos, t);
    defenderMesh.rotation.x = Math.sin(t * Math.PI) * 0.4;

    if (t >= 1) {
      if (animState.playType === 'bunt_hit') {
        completeAnimation();
      } else {
        animState.phase = 'defense';
        animState.time = 0;
        animState.duration = 0.45;
        animState.startPos.copy(animState.endPos);
        animState.endPos.copy(fieldersMap['1B'].basePos).add(new THREE.Vector3(0, 0.8, 0));
        animState.controlPos.copy(animState.startPos).add(animState.endPos).multiplyScalar(0.5).add(new THREE.Vector3(0, 1.2, 0));
      }
    }
    return;
  }

  if (animState.phase === 'steal') {
    const startBasePos = animState.targetBase === '2B' ? new THREE.Vector3(12, 0, 0) : new THREE.Vector3(0, 0, -12);
    const endBasePos = animState.targetBase === '2B' ? new THREE.Vector3(0, 0, -12) : new THREE.Vector3(-12, 0, 0);

    runnerMeshes[0].position.lerpVectors(startBasePos, endBasePos, t);
    runnerMeshes[0].rotation.z = Math.sin(t * Math.PI * 8) * 0.15;

    const p0 = animState.startPos;
    const p1 = animState.controlPos;
    const p2 = animState.endPos;
    ball.position.x = (1 - t) * (1 - t) * p0.x + 2 * (1 - t) * t * p1.x + t * t * p2.x;
    ball.position.y = (1 - t) * (1 - t) * p0.y + 2 * (1 - t) * t * p1.y + t * t * p2.y;
    ball.position.z = (1 - t) * (1 - t) * p0.z + 2 * (1 - t) * t * p2.z + t * t * p2.z;
    addBallTrailPoint(ball.position);

    if (animState.activeFielderKey) {
      const fMesh = fieldersMap[animState.activeFielderKey].mesh;
      fMesh.position.lerpVectors(animState.fielderStartPos, animState.fielderEndPos, t);
      fMesh.rotation.y = Math.sin(t * Math.PI) * 0.5;
    }

    if (t >= 1) completeAnimation();
    return;
  }

  if (animState.phase === 'pitching') {
    let pPos = new THREE.Vector3().lerpVectors(animState.startPos, animState.endPos, t);
    const pType = animState.pitchType || '';
    
    const breakFactor = Math.sin(t * Math.PI); 
    let curveX = 0, curveY = 0;

    if (pType.includes('슬라이더') || pType.includes('스위퍼') || pType.includes('슬러브')) {
      curveX = -0.45 * Math.pow(t, 1.4) * breakFactor;
      curveY = -0.15 * breakFactor;
    } else if (pType.includes('커브')) {
      curveX = -0.15 * breakFactor;
      curveY = (0.35 * Math.sin(t * Math.PI) - 0.45 * t) * breakFactor;
    } else if (pType.includes('포크') || pType.includes('스플리터')) {
      curveX = 0;
      curveY = -0.55 * Math.pow(t, 2) * breakFactor;
    } else if (pType.includes('체인지업') || pType.includes('투심') || pType.includes('싱커')) {
      curveX = 0.35 * breakFactor;
      curveY = -0.25 * breakFactor;
    } else if (pType.includes('커터') || pType.includes('컷패스트볼')) {
      curveX = -0.22 * Math.pow(t, 1.4) * breakFactor;
      curveY = -0.08 * breakFactor;
    }

    pPos.x += curveX;
    pPos.y += curveY;
    ball.position.copy(pPos);
    addBallTrailPoint(ball.position);

    if (t >= 1) {
      updateABS(animState.pitchX, animState.pitchY, animState.outcome);

      const outc = animState.outcome;
      if (outc === 'ball' || outc === 'strike_looking' || outc === 'strike_swinging') {
        playSound('catch');
        completeAnimation();
        return;
      }

      animState.phase = 'hitting';
      animState.time = 0;

      if (outc === 'foul') {
        animState.duration = 0.85;
        animState.startPos.set(animState.pitchX, animState.pitchY, 12);
        const side = Math.random() < 0.5 ? -1 : 1;
        animState.endPos.set(side * 22, 0.1, 15);
        animState.controlPos.set(side * 11, 7, 13); 
      } else if (outc === 'out') {
        const isFlyout = Math.random() < 0.5;
        animState.playType = isFlyout ? 'flyout' : 'grounder';

        let targetFielderKey = '';
        let targetPos = new THREE.Vector3();
        let height = 3;
        let dur = 1.3;

        if (isFlyout) {
          targetFielderKey = pick(['LF', 'CF', 'RF']);
          const basePos = fieldersMap[targetFielderKey].basePos;
          targetPos.copy(basePos).add(new THREE.Vector3((Math.random() - 0.5) * 3, 0, (Math.random() - 0.5) * 3));
          targetPos.y = 0.8; 
          height = 11; dur = 1.5;
        } else {
          targetFielderKey = pick(['2B', 'SS', '3B']); 
          const basePos = fieldersMap[targetFielderKey].basePos;
          targetPos.copy(basePos).add(new THREE.Vector3((Math.random() - 0.5) * 1.5, 0, (Math.random() - 0.5) * 1.5));
          targetPos.y = 0.1; 
          height = 0.8; dur = 1.0;
        }

        animState.activeFielderKey = targetFielderKey;
        animState.fielderStartPos.copy(fieldersMap[targetFielderKey].mesh.position);
        animState.fielderEndPos.copy(targetPos);
        animState.fielderEndPos.y = 0; 

        animState.startPos.set(animState.pitchX, animState.pitchY, 12);
        animState.endPos.copy(targetPos);
        animState.controlPos.set((animState.startPos.x + targetPos.x) / 2, height, (animState.startPos.z + targetPos.z) / 2);
        animState.duration = dur;

      } else {
        let h = 5, dur = 1.2;
        let target = new THREE.Vector3();
        if (outc === 'single') {
          target.set((Math.random() - 0.5) * 16, 0.1, -15); h = 5; dur = 1.1;
        } else if (outc === 'double') {
          target.set((Math.random() - 0.5) * 26, 0.1, -25); h = 8; dur = 1.4;
        } else if (outc === 'triple') {
          target.set((Math.random() < 0.5 ? -33 : 33), 0.1, -30); h = 10; dur = 1.6;
        } else if (outc === 'homerun') {
          target.set((Math.random() - 0.5) * 28, 0.5, -58); h = 26; dur = 2.4;
        }
        animState.startPos.set(animState.pitchX, animState.pitchY, 12);
        animState.endPos.copy(target);
        animState.controlPos.set(target.x / 2, h, (12 + target.z) / 2);
        animState.duration = dur;
      }
    }
  } else if (animState.phase === 'hitting') {
    const swingOutcomes = ['foul', 'out', 'single', 'double', 'triple', 'homerun'];
    if (swingOutcomes.includes(animState.outcome)) {
      if (animState.outcome === 'homerun') {
        batterMesh.rotation.y = -Math.PI / 2 - Math.sin(t * Math.PI) * 3.6;
        const batGroup = batterMesh.getObjectByName("batGroup");
        if (batGroup && t > 0.3) {
          batGroup.position.set(0.35 + Math.sin(t * Math.PI * 4) * 0.8, 1.2 + t * 2.0, 0.1 + t * 1.5);
          batGroup.rotation.z += 0.35;
        }
        const lArm = batterMesh.getObjectByName("leftArm");
        const rArm = batterMesh.getObjectByName("rightArm");
        if (lArm && rArm && t > 0.4) {
          lArm.rotation.z = Math.min(2.2, lArm.rotation.z + 0.15);
          rArm.rotation.z = Math.max(-2.2, rArm.rotation.z - 0.15);
        }
      } else {
        batterMesh.rotation.y = -Math.PI / 2 - Math.sin(t * Math.PI) * 2.8;
      }
    }

    if (animState.outcome === 'homerun') {
      const camTargetPos = new THREE.Vector3(
        ball.position.x * 0.5,
        Math.max(3.5, ball.position.y * 0.6 + 2.0),
        ball.position.z + 14
      );
      camera.position.lerp(camTargetPos, 0.08);
      camera.lookAt(ball.position);
    }

    if (animState.activeFielderKey && fieldersMap[animState.activeFielderKey]) {
      const fielderMesh = fieldersMap[animState.activeFielderKey].mesh;
      fielderMesh.position.lerpVectors(animState.fielderStartPos, animState.fielderEndPos, t);
      if (t > 0.6) {
        fielderMesh.rotation.z = Math.sin((t - 0.6) * Math.PI * 2.5) * 0.5;
      }
    }

    const p0 = animState.startPos;
    const p1 = animState.controlPos;
    const p2 = animState.endPos;

    if (animState.outcome === 'out' && animState.playType === 'grounder') {
      ball.position.x = THREE.MathUtils.lerp(p0.x, p2.x, t);
      ball.position.z = THREE.MathUtils.lerp(p0.z, p2.z, t);
      ball.position.y = Math.sin(t * Math.PI) * 0.25 + 0.12;
    } else {
      ball.position.x = (1 - t) * (1 - t) * p0.x + 2 * (1 - t) * t * p1.x + t * t * p2.x;
      ball.position.y = (1 - t) * (1 - t) * p0.y + 2 * (1 - t) * t * p1.y + t * t * p2.y;
      ball.position.z = (1 - t) * (1 - t) * p0.z + 2 * (1 - t) * t * p1.z + t * t * p2.z;
    }
    addBallTrailPoint(ball.position);

    if (t >= 1) {
      if (animState.outcome === 'out') {
        if (animState.playType === 'grounder') {
          animState.phase = 'defense';
          animState.time = 0;
          animState.duration = 0.45; 

          animState.startPos.copy(animState.fielderEndPos).add(new THREE.Vector3(-0.35, 0.55, 0)); 
          animState.endPos.copy(fieldersMap['1B'].basePos).add(new THREE.Vector3(-0.35, 0.55, 0)); 
          animState.controlPos.copy(animState.startPos).add(animState.endPos).multiplyScalar(0.5).add(new THREE.Vector3(0, 1.2, 0));
        } else {
          animState.phase = 'defense_pause';
          animState.time = 0;
          animState.duration = 0.5; 
        }
      } else {
        const runOutcomes = ['single', 'double', 'triple', 'homerun', 'walk'];
        if (runOutcomes.includes(animState.outcome)) {
          startRunningPhase(runOutcomes);
        } else {
          completeAnimation();
        }
      }
    }
  } else if (animState.phase === 'defense') {
    const p0 = animState.startPos;
    const p1 = animState.controlPos;
    const p2 = animState.endPos;
    ball.position.x = (1 - t) * (1 - t) * p0.x + 2 * (1 - t) * t * p1.x + t * t * p2.x;
    ball.position.y = (1 - t) * (1 - t) * p0.y + 2 * (1 - t) * t * p1.y + t * t * p2.y;
    ball.position.z = (1 - t) * (1 - t) * p0.z + 2 * (1 - t) * t * p1.z + t * t * p2.z;
    addBallTrailPoint(ball.position);

    if (t >= 1) {
      ball.position.copy(fieldersMap['1B'].basePos).add(new THREE.Vector3(-0.35, 0.55, 0));
      playSound('catch');
      completeAnimation();
    }
  } else if (animState.phase === 'defense_pause') {
    if (animState.activeFielderKey && fieldersMap[animState.activeFielderKey]) {
      const fMesh = fieldersMap[animState.activeFielderKey].mesh;
      ball.position.copy(fMesh.position).add(new THREE.Vector3(-0.35, 0.55, 0)); 
    }
    if (t >= 1) {
      playSound('catch');
      completeAnimation();
    }
  } else if (animState.phase === 'running') {
    animState.animPaths.forEach(ap => {
      ap.mesh.position.copy(getPointAlongPath(ap.path, t));
      ap.mesh.rotation.z = Math.sin(t * Math.PI * 10) * 0.12;
    });

    if (t >= 1) {
      completeAnimation();
    }
  }
}

function startRunningPhase(runOutcomes) {
  animState.phase = 'running';
  animState.time = 0;
  animState.duration = 1.5; 

  const baseCoords = [
    new THREE.Vector3(0, 0, 12),
    new THREE.Vector3(12, 0, 0),
    new THREE.Vector3(0, 0, -12),
    new THREE.Vector3(-12, 0, 0),
    new THREE.Vector3(0, 0, 12)
  ];

  let steps = 0;
  if (animState.outcome === 'single') steps = 1;
  else if (animState.outcome === 'double') steps = 2;
  else if (animState.outcome === 'triple') steps = 3;
  else if (animState.outcome === 'homerun') steps = 4;
  else if (animState.outcome === 'walk') steps = 1;

  let animPaths = [];

  let bPath = [];
  for (let s = 0; s <= steps; s++) bPath.push(baseCoords[s].clone());
  animPaths.push({ mesh: runnerMeshes[0], path: bPath });

  if (state.bases[0]) {
    let rSteps = steps;
    if (animState.outcome === 'walk') rSteps = 1;
    let rPath = [];
    for (let s = 0; s <= rSteps; s++) rPath.push(baseCoords[Math.min(1 + s, 4)].clone());
    animPaths.push({ mesh: runnerMeshes[1], path: rPath });
  }

  if (state.bases[1]) {
    let rSteps = steps;
    if (animState.outcome === 'walk') rSteps = state.bases[0] ? 1 : 0;
    if (rSteps > 0) {
      let rPath = [];
      for (let s = 0; s <= rSteps; s++) rPath.push(baseCoords[Math.min(2 + s, 4)].clone());
      animPaths.push({ mesh: runnerMeshes[2], path: rPath });
    } else {
      runnerMeshes[2].position.copy(baseCoords[2]);
      runnerMeshes[2].visible = true;
    }
  }

  if (state.bases[2]) {
    let rSteps = steps;
    if (animState.outcome === 'walk') rSteps = (state.bases[0] && state.bases[1]) ? 1 : 0;
    if (rSteps > 0) {
      let rPath = [];
      for (let s = 0; s <= rSteps; s++) rPath.push(baseCoords[Math.min(3 + s, 4)].clone());
      animPaths.push({ mesh: runnerMeshes[3], path: rPath });
    } else {
      runnerMeshes[3].position.copy(baseCoords[3]);
      runnerMeshes[3].visible = true;
    }
  }

  runnerMeshes.forEach(m => m.visible = false);
  animPaths.forEach(ap => {
    ap.mesh.visible = true;
    ap.mesh.position.copy(ap.path[0]);
  });

  if (state.bases[0] && animState.outcome !== 'walk' && steps === 0) {
    runnerMeshes[1].visible = true;
    runnerMeshes[1].position.copy(baseCoords[1]);
  }
  if (state.bases[1] && !(animState.outcome === 'walk' ? state.bases[0] : (steps > 0))) {
    runnerMeshes[2].visible = true;
    runnerMeshes[2].position.copy(baseCoords[2]);
  }
  if (state.bases[2] && !(animState.outcome === 'walk' ? (state.bases[0] && state.bases[1]) : (steps > 0))) {
    runnerMeshes[3].visible = true;
    runnerMeshes[3].position.copy(baseCoords[3]);
  }

  animState.animPaths = animPaths;
}

function getPointAlongPath(path, t) {
  if (path.length === 0) return new THREE.Vector3();
  if (path.length === 1) return path[0].clone();
  if (t >= 1) return path[path.length - 1].clone();

  const segments = path.length - 1;
  const progress = t * segments;
  const index = Math.floor(progress);
  const segmentT = progress - index;

  return new THREE.Vector3().lerpVectors(path[index], path[index + 1], segmentT);
}

function completeAnimation() {
  animState.active = false;
  animState.phase = 'none';

  batterMesh.rotation.y = -Math.PI / 2; 
  pitcherMesh.rotation.y = 0;
  pitcherMesh.position.set(0, 0.15, 0);
  catcherMesh.position.set(0, 0, 13.2);
  
  const batGroup = batterMesh.getObjectByName("batGroup");
  if (batGroup) {
    batGroup.rotation.set(0.2, 0, -Math.PI / 4.2);
    batGroup.position.set(0.35, 0.85, 0.1);
  }

  const lArm = batterMesh.getObjectByName("leftArm");
  const rArm = batterMesh.getObjectByName("rightArm");
  if (lArm) lArm.rotation.z = 0.25;
  if (rArm) rArm.rotation.z = -0.25;

  ball.position.set(0, 1.2, 0);         
  resetBallTrail();

  runnerMeshes.forEach(m => {
    m.visible = false;
    m.rotation.z = 0;
  });

  for (const key in fieldersMap) {
    const f = fieldersMap[key];
    if (f.mesh) {
      f.mesh.position.copy(f.basePos);
      f.mesh.rotation.set(0, 0, 0);
    }
  }

  if (animState.onComplete) {
    animState.onComplete();
  }

  const choiceBox = document.getElementById('choiceButtons');
  if (choiceBox) {
    choiceBox.style.pointerEvents = 'auto';
    choiceBox.style.opacity = '1';
  }
}

/* ==========================================================================
   ABS 존 그래픽 렌더러 (세로 직사각형 정밀 매핑 연동)
   ========================================================================== */
function updateABS(x, y, outcome) {
  const canvas = document.getElementById('absCanvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const w = canvas.width;
  const h = canvas.height;

  ctx.clearRect(0, 0, w, h);

  // 모눈 배경
  ctx.strokeStyle = 'rgba(255,255,255,0.04)';
  ctx.lineWidth = 1;
  for (let i = 1; i < 6; i++) {
    let yLine = (h / 6) * i;
    ctx.beginPath(); ctx.moveTo(0, yLine); ctx.lineTo(w, yLine); ctx.stroke();
  }
  for (let i = 1; i < 4; i++) {
    let xLine = (w / 4) * i;
    ctx.beginPath(); ctx.moveTo(xLine, 0); ctx.lineTo(xLine, h); ctx.stroke();
  }

  // 3D 좌표 -> 캔버스 세로 직사각형 매핑
  const mapX = (val) => w / 2 + (val / 0.60) * (w / 2);
  const mapY = (val) => h - ((val - 0.10) / 1.40) * h;

  // 세로 직사각형 스트라이크 존 경계 (-0.25 ~ +0.25, 0.50 ~ 1.20)
  const left = mapX(-0.25);
  const right = mapX(0.25);
  const top = mapY(1.20);
  const bottom = mapY(0.50);
  const zoneW = right - left;
  const zoneH = bottom - top;

  // 메인 존 사각형
  ctx.fillStyle = 'rgba(255, 206, 84, 0.08)';
  ctx.fillRect(left, top, zoneW, zoneH);

  // 3x3 격자선
  ctx.strokeStyle = 'rgba(255, 206, 84, 0.35)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  for (let i = 1; i < 3; i++) {
    ctx.moveTo(left + (zoneW / 3) * i, top);
    ctx.lineTo(left + (zoneW / 3) * i, bottom);
    ctx.moveTo(left, top + (zoneH / 3) * i);
    ctx.lineTo(right, top + (zoneH / 3) * i);
  }
  ctx.stroke();

  // ABS 테두리
  ctx.strokeStyle = '#ffce54';
  ctx.lineWidth = 2;
  ctx.shadowColor = 'rgba(255, 206, 84, 0.6)';
  ctx.shadowBlur = 6;
  ctx.strokeRect(left, top, zoneW, zoneH);
  ctx.shadowBlur = 0;

  // 홈플레이트 가이드
  const plateY = bottom + 10;
  ctx.fillStyle = 'rgba(255, 255, 255, 0.25)';
  ctx.beginPath();
  ctx.moveTo(w / 2 - 14, plateY);
  ctx.lineTo(w / 2 + 14, plateY);
  ctx.lineTo(w / 2 + 14, plateY + 5);
  ctx.lineTo(w / 2, plateY + 10);
  ctx.lineTo(w / 2 - 14, plateY + 5);
  ctx.closePath();
  ctx.fill();

  if (x !== undefined && x !== null && y !== undefined && y !== null) {
    const cx = mapX(x);
    const cy = mapY(y);
    const isStrike = ['strike_looking', 'strike_swinging', 'foul', 'out', 'single', 'double', 'triple', 'homerun'].includes(outcome);

    const glowRad = 12;
    const grad = ctx.createRadialGradient(cx, cy, 2, cx, cy, glowRad);
    if (isStrike) {
      grad.addColorStop(0, 'rgba(0, 230, 118, 0.95)'); 
      grad.addColorStop(1, 'rgba(0, 230, 118, 0)');
    } else {
      grad.addColorStop(0, 'rgba(255, 82, 82, 0.95)'); 
      grad.addColorStop(1, 'rgba(255, 82, 82, 0)');
    }
    ctx.fillStyle = grad;
    ctx.beginPath(); ctx.arc(cx, cy, glowRad, 0, Math.PI * 2); ctx.fill();

    ctx.fillStyle = isStrike ? '#00e676' : '#ff5252';
    ctx.beginPath(); ctx.arc(cx, cy, 4.5, 0, Math.PI * 2); ctx.fill();

    ctx.fillStyle = '#ffffff';
    ctx.beginPath(); ctx.arc(cx - 1.0, cy - 1.0, 1.5, 0, Math.PI * 2); ctx.fill();

    const info = document.getElementById('absInfo');
    if (info) {
      if (outcome === 'ball') {
        info.innerHTML = `<span style="color:#ff5252; font-weight:900; letter-spacing:0.5px;">BALL</span><br><span style="color:#ffffff; font-weight:700;">${animState.pitchType}</span><br>(${animState.pitchSpeed}km/h)`;
      } else if (outcome === 'strike_looking') {
        info.innerHTML = `<span style="color:#00e676; font-weight:900; letter-spacing:0.5px;">STRIKE</span><br><span style="color:#ffffff; font-weight:700;">${animState.pitchType}</span><br>(${animState.pitchSpeed}km/h)`;
      } else {
        const suffix = ['single', 'double', 'triple', 'homerun'].includes(outcome) ? 'HIT' : 'SWING';
        const displayColor = suffix === 'HIT' ? '#ffce54' : '#00e676';
        info.innerHTML = `<span style="color:${displayColor}; font-weight:900; letter-spacing:0.5px;">${suffix}</span><br><span style="color:#ffffff; font-weight:700;">${animState.pitchType}</span><br>(${animState.pitchSpeed}km/h)`;
      }
    }
  } else {
    const info = document.getElementById('absInfo');
    if (info) info.innerHTML = '<span style="color:rgba(242,237,225,0.45);">판정 대기 중</span>';
  }
}
</script>
