  if (!scoreboardContext) return;
  const ctx = scoreboardContext;
  const w = 512, h = 256;

  ctx.fillStyle = '#030a08'; ctx.fillRect(0, 0, w, h);
  ctx.strokeStyle = '#ffce54'; ctx.lineWidth = 6;
  ctx.strokeRect(8, 8, w - 16, h - 16);

  const homeTeamName = state ? state.home.name : "KBO 홈팀";
  const stInfo = STADIUM_DATA[homeTeamName] || STADIUM_DATA["KIA 타이거즈"];

  ctx.fillStyle = '#ffce54'; ctx.font = 'bold 22px sans-serif'; ctx.textAlign = 'center';
  ctx.fillText(`🏟️ ${stInfo.name}`, w / 2, 36);

  if (state) {
    ctx.fillStyle = '#ffffff'; ctx.font = 'bold 28px sans-serif'; ctx.textAlign = 'left';
    ctx.fillText(`${state.away.name}`, 35, 90);
    ctx.fillText(`${state.home.name}`, 35, 142);

    ctx.font = 'bold 36px monospace'; ctx.fillStyle = '#ffdd7a';
    ctx.fillText(`${state.score.away}`, 280, 92);
    ctx.fillText(`${state.score.home}`, 280, 144);

    ctx.fillStyle = '#00e676'; ctx.font = 'bold 26px sans-serif';
    ctx.fillText(`${state.inning}회${state.half==='top'?'초':'말'}`, 365, 90);

    ctx.fillStyle = '#ffffff'; ctx.font = 'bold 19px sans-serif';
    ctx.fillText(`B: ${state.balls}  S: ${state.strikes}  O: ${state.outs}`, 365, 142);

    const batter = currentBatter();
    ctx.fillStyle = '#4fc3f7'; ctx.font = 'bold 21px sans-serif';
    ctx.fillText(`타석: ${batter.name} (${batter.pos})`, 35, 205);

    if (animState && animState.pitchSpeed) {
      ctx.fillStyle = '#ff5252'; ctx.font = 'bold 22px sans-serif'; ctx.textAlign = 'right';
      ctx.fillText(`구속: ${animState.pitchSpeed} km/h`, w - 35, 205);
    }
  } else {
    ctx.fillStyle = '#888888'; ctx.font = '22px sans-serif'; ctx.fillText('경기 대기 중...', w / 2, 140);
  }

  if (scoreboardTexture) scoreboardTexture.needsUpdate = true;
}

