function doPickoff(targetBase) {
  addLog(`🎯 [플레이어 수비] ${targetBase==='1B'?'1루':'2루'} 견제구를 던집니다!`);
  playSound('pitch');

  const rand = Math.random();
  let result = 'safe';
  if (rand < 0.15) result = 'out';
  else if (rand < 0.20) result = 'wild';

  start3DPickoffAnimation(targetBase, result, () => {
    playSound('catch');
    if (result === 'out') {
      const idx = targetBase === '1B' ? 0 : 1;
      const runnerName = state.bases[idx] ? state.bases[idx].name : '주자';
      state.bases[idx] = null;
      addLog(`🚨 ${pick(FLAVOR.pickoff_out)} (${runnerName} 아웃!)`);
      recordOut();
    } else if (result === 'wild') {
      addLog(`⚠️ ${pick(FLAVOR.pickoff_wild)}`);
      advanceRunners(1, null);
      render();
    } else {
      addLog(`💨 ${pick(FLAVOR.pickoff_safe)}`);
      render();
    }
  });
}

function doBunt() {
  const batter = currentBatter();
  const speed = (TYPE_MODIFIER[batter.type] && TYPE_MODIFIER[batter.type].speed) || 70;
  
  const successChance = 0.25 + (speed / 300);
  const isSuccess = Math.random() < successChance;

  state.pitchersPitches.away[state.activePitcherKey.away]++;
  playSound('pitch');

  start3DBuntAnimation(isSuccess, () => {
    playSound(isSuccess ? 'hit' : 'catch');
    if (isSuccess) {
      if (Math.random() < 0.25) { 
        const scored = advanceRunners(1, { name: batter.name, speed: speed });
        addLog(`⚡ ${pick(FLAVOR.bunt_success)} (번트 내야안타!)` + (scored > 0 ? ` (${scored}점 획득)` : ''));
        state.score[battingKey()] += scored;
        checkWalkoff();
        if (!state.gameOver) endAtBat();
      } else { 
        const scored = advanceRunners(1, null);
        addLog(`🎯 희생번트 성공! 타자는 1루에서 아웃, 주자 진루.` + (scored > 0 ? ` (${scored}점 획득)` : ''));
        state.score[battingKey()] += scored;
        checkWalkoff();
        recordOut();
      }
    } else {
      addLog(`❌ ${pick(FLAVOR.bunt_out)}`);
      recordOut();
    }
  });
}

function doSteal() {
  let targetBase = '2B';
  let runnerIdx = 0;

  if (state.bases[0]) {
    targetBase = '2B';
    runnerIdx = 0;
  } else if (state.bases[1]) {
    targetBase = '3B';
    runnerIdx = 1;
  }

  const runner = state.bases[runnerIdx];
  const runnerSpeed = runner ? runner.speed : 75;
  
  const stealSuccessChance = 0.15 + (runnerSpeed / 100) * 0.18;
  const isSuccess = Math.random() < stealSuccessChance;

  playSound('pitch');

  start3DStealAnimation(targetBase, isSuccess, () => {
    playSound('catch');
    if (isSuccess) {
      addLog(`⚡ ${pick(FLAVOR.steal_success)} (${runner.name} ${targetBase} 헤드퍼스트 슬라이딩 세이프!)`);
      if (targetBase === '2B') {
        state.bases[1] = state.bases[0];
        state.bases[0] = null;
      } else if (targetBase === '3B') {
        state.bases[2] = state.bases[1];
        state.bases[1] = null;
      }
      render();
    } else {
      addLog(`🚨 ${pick(FLAVOR.steal_out)} (${runner.name} 포수 칼송구에 태그아웃!)`);
      state.bases[runnerIdx] = null;
      recordOut();
    }
  });
}

function doPitch(choice){
  const batter = currentBatter();
  const mods = TYPE_MODIFIER[batter.type] || {};
  const stamina = state.pitchersStamina.home[state.activePitcherKey.home];
  
  state.pitchersPitches.home[state.activePitcherKey.home]++;
  
  if (state.bases[0] && Math.random() < 0.05) {
    addLog(`🚨 [AI 원정팀] 기습 도루를 감행합니다!`);
    const isSuccess = Math.random() < 0.25;
    playSound('pitch');
    start3DStealAnimation('2B', isSuccess, () => {
      playSound('catch');
      if (isSuccess) {
        addLog(`⚡ AI 원정팀 도루 성공! 2루 세이프!`);
        state.bases[1] = state.bases[0];
        state.bases[0] = null;
        render();
      } else {
        addLog(`🚨 포수의 신속 송구! AI 원정팀 도루 저지 완료!`);
        state.bases[0] = null;
        recordOut();
      }
    });
    return;
  }

  const outcome = weightedPick(PITCH_BASE[choice], mods, stamina);
  
  start3DAnimation(outcome, () => {
    resolveOutcome(outcome);
  }, choice);
}

function doBat(choice){
  const pitchIsStrike = Math.random() < 0.58;
  const table = BAT_TABLE[choice][pitchIsStrike?'strike':'ball'];
  const stamina = state.pitchersStamina.away[state.activePitcherKey.away];
  
  state.pitchersPitches.away[state.activePitcherKey.away]++;

  const outcome = weightedPick(table, {}, stamina);
  const aiChoice = pick([1, 2, 3]); 
  
  start3DAnimation(outcome, () => {
    resolveOutcome(outcome);
  }, aiChoice);
}

function resolveOutcome(outcome){
  switch(outcome){
    case 'ball':
      playSound('ball');
      state.balls++;
      if(state.balls>=4){ walkBatter(); }
      else { addLog(pick(FLAVOR.ball)); render(); }
      break;
    case 'strike_looking':
    case 'strike_swinging':
      playSound('strike');
      state.strikes++;
      if(state.strikes>=3){ addLog(pick(FLAVOR.strikeout)); recordOut(); }
      else { addLog(pick(FLAVOR[outcome])); render(); }
      break;
    case 'foul':
      playSound('hit');
      if(state.strikes<2) state.strikes++;
      addLog(pick(FLAVOR.foul));
      render();
      break;
    case 'out':
      playSound('hit');
      handleBattedOut();
      break;
    case 'single': playSound('hit'); doHit(1,'single'); break;
    case 'double': playSound('hit'); doHit(2,'double'); break;
    case 'triple': playSound('hit'); doHit(3,'triple'); break;
    case 'homerun': playSound('homerun'); doHit(4,'homerun'); break;
  }
}

function handleBattedOut(){
  if(state.bases[0] && state.outs<2 && Math.random()<0.3){
    state.bases[0]=null;
    state.outs+=2;
    addLog(pick(FLAVOR.double_play));
  } else {
    state.outs+=1;
    addLog(pick(FLAVOR.out));
  }
  endAtBat();
}

function doHit(n, type){
  const batter = currentBatter();
  const speed = (TYPE_MODIFIER[batter.type] && TYPE_MODIFIER[batter.type].speed) || 75;
  const scored = advanceRunners(n, { name: batter.name, speed: speed });
  addLog(pick(FLAVOR[type]) + (scored>0 ? ` (${scored}점 획득)`:''));
  state.score[battingKey()] += scored;
  if(scored > 0) playSound('cheer');
  checkWalkoff();
  if(!state.gameOver) endAtBat();
}

function walkBatter(){
  const batter = currentBatter();
  const speed = (TYPE_MODIFIER[batter.type] && TYPE_MODIFIER[batter.type].speed) || 75;
  const newRunner = { name: batter.name, speed: speed };
  
  const b = state.bases;
  let scored=0;
  if(b[0]){
    if(b[1]){
      if(b[2]) scored=1; 
      b[2]=b[1]; b[1]=b[0]; b[0]=newRunner;
    } else {
      b[1]=b[0]; b[0]=newRunner;
    }
  } else {
    b[0]=newRunner;
  }
  state.score[battingKey()] += scored;
  addLog(pick(FLAVOR.walk) + (scored>0?' (밀어내기 1점!)':''));
  if(scored > 0) playSound('cheer');
  checkWalkoff();
  if(!state.gameOver) endAtBat();
}

function advanceRunners(n, batterPlayer){
  let scored=0;
  const b = state.bases;
  const newBases = [null, null, null];

  for(let i=2; i>=0; i--){
    if(b[i]){
      const newPos = (i+1)+n;
      if(newPos>=4){ scored++; } else { newBases[newPos-1] = b[i]; }
    }
  }

  if (batterPlayer) {
    const battersPos = n;
    if(battersPos>=4){ scored++; } else { newBases[battersPos-1] = batterPlayer; }
  }

  state.bases = newBases;
  return scored;
}

function checkWalkoff(){
  if(state.half==='bottom' && state.inning>=9 && state.score.home>state.score.away){
    endGame(false, true);
  }
}

function recordOut(){
  state.outs+=1;
  endAtBat();
}

function checkAIPitcherChange(){
  if (state.half === 'bottom') {
    const activeKey = state.activePitcherKey.away;
    const curStamina = state.pitchersStamina.away[activeKey];
    const isLateInning = state.inning >= 8;
    const team = state.away;
    
    if (isLateInning && activeKey !== 'closer' && !state.usedPitchers.away.includes('closer')) {
      if (!state.usedPitchers.away.includes(activeKey)) {
        state.usedPitchers.away.push(activeKey);
      }
      state.activePitcherKey.away = 'closer';
      addLog(`🔄 [원정팀 투수 교체] 마무리 ${team.pitchers.closer.name} 마운드 등판!`);
    } 
    else if (curStamina < 40) {
      const rps = ['rp1', 'rp2', 'rp3'];
      const availableRPs = rps.filter(k => !state.usedPitchers.away.includes(k) && k !== activeKey);
      
      if (availableRPs.length > 0) {
        let bestRPKey = availableRPs[0];
        let maxStam = -1;
        availableRPs.forEach(k => {
          if (state.pitchersStamina.away[k] > maxStam) {
            maxStam = state.pitchersStamina.away[k];
            bestRPKey = k;
          }
        });
        
        if (maxStam > 30) {
          state.usedPitchers.away.push(activeKey);
          state.activePitcherKey.away = bestRPKey;
          addLog(`🔄 [원정팀 투수 교체] 구원계투 ${team.pitchers[bestRPKey].name} 교체!`);
        }
      }
    }
  }
}

function endAtBat(){
  if (state.half === 'top') {
    const activeKey = state.activePitcherKey.home;
    const isSP = activeKey.startsWith('sp');
    const loss = isSP ? Math.floor(3 + Math.random() * 2) : Math.floor(12 + Math.random() * 6);
    state.pitchersStamina.home[activeKey] = Math.max(0, state.pitchersStamina.home[activeKey] - loss);
  } else {
    const activeKey = state.activePitcherKey.away;
    const isSP = activeKey.startsWith('sp');
    const loss = isSP ? Math.floor(3 + Math.random() * 2) : Math.floor(12 + Math.random() * 6);
    state.pitchersStamina.away[activeKey] = Math.max(0, state.pitchersStamina.away[activeKey] - loss);
  }

  state.balls=0; state.strikes=0;
  state.lineupIdx[battingKey()] = (state.lineupIdx[battingKey()]+1) % 9;
  if(state.gameOver) return;
  if(state.outs>=3){ endHalfInning(); }
  else { 
    checkAIPitcherChange();
    render(); 
  }
}

function endHalfInning(){
  state.outs=0; state.balls=0; state.strikes=0;
  state.bases=[null, null, null];

  if(state.half==='top'){
    if(state.inning>=9 && state.score.home>state.score.away){
      endGame(false,false);
      return;
    }
    state.half='bottom';
    addLog(`— ${state.inning}회말 시작, ${state.home.name} 공격 —`);
  } else {
    if(state.inning>=9){
      if(state.score.home!==state.score.away){
        endGame(false,false);
        return;
      } else if(state.inning>=12){
        endGame(true,false);
        return;
      } else {
        state.inning++;
        state.half='top';
        addLog(`— ${state.inning}회초 시작, ${state.away.name} 공격 (연장) —`);
      }
    } else {
      state.inning++;
      state.half='top';
      addLog(`— ${state.inning}회초 시작, ${state.away.name} 공격 —`);
    }
  }
  checkAIPitcherChange();
  render();
}

function endGame(isDraw, isWalkoff){
  state.gameOver = true;
  document.getElementById('gameScreen').style.display = 'none';
  const endScreen = document.getElementById('endScreen');
  endScreen.style.display = 'block';

  const title = document.getElementById('endTitle');
  const sub = document.getElementById('endSub');
  const score = document.getElementById('finalScore');

  score.textContent = `${state.score.away} : ${state.score.home}`;

  if (isDraw) {
    title.textContent = "🤝 경기 종료 (무승부)";
    sub.textContent = "12회 연장 끝에 승부를 가리지 못하고 무승부로 경기가 종료되었습니다.";
  } else {
    const playerWon = state.score.home > state.score.away;
    if (playerWon) {
      playSound('cheer');
      title.textContent = isWalkoff ? "🎉 끝내기 승리!" : "🎉 승리하였습니다!";
      sub.textContent = `플레이어 팀(${state.home.name})이 멋진 승리를 거두었습니다!`;
    } else {
      title.textContent = "패배하였습니다";
      sub.textContent = `아쉽게도 AI 팀(${state.away.name})에 승리를 내주었습니다.`;
    }
  }
}

