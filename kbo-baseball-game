function updateStaticRunners() {
  if (!runnerMeshes || runnerMeshes.length < 4 || animState.active) return;
  const baseCoords = [
    new THREE.Vector3(0, 0, 12),
    new THREE.Vector3(12, 0, 0),
    new THREE.Vector3(0, 0, -12),
    new THREE.Vector3(-12, 0, 0)
  ];
  runnerMeshes.forEach(m => m.visible = false);
  if (state.bases[0]) {
    runnerMeshes[1].position.copy(baseCoords[1]);
    runnerMeshes[1].visible = true;
  }
  if (state.bases[1]) {
    runnerMeshes[2].position.copy(baseCoords[2]);
    runnerMeshes[2].visible = true;
  }
  if (state.bases[2]) {
    runnerMeshes[3].position.copy(baseCoords[3]);
    runnerMeshes[3].visible = true;
  }
}

function updateTeamColors() {
  if (!pitcherMesh || !batterMesh || !state) return;

  const homeTeamName = state.home.name;
  const awayTeamName = state.away.name;

  const homeUniform = UNIFORM_DATA[homeTeamName] ? UNIFORM_DATA[homeTeamName].home : UNIFORM_DATA["KIA 타이거즈"].home;
  const awayUniform = UNIFORM_DATA[awayTeamName] ? UNIFORM_DATA[awayTeamName].away : UNIFORM_DATA["삼성 라이온즈"].away;

  const fieldingUniform = (state.half === 'top') ? homeUniform : awayUniform;
  const battingUniform = (state.half === 'top') ? awayUniform : homeUniform;

  applyUniformToPlayer(pitcherMesh, fieldingUniform);
  applyUniformToPlayer(catcherMesh, fieldingUniform);
  applyUniformToPlayer(batterMesh, battingUniform);

  for (const key in fieldersMap) {
    if (fieldersMap[key].mesh) {
      applyUniformToPlayer(fieldersMap[key].mesh, fieldingUniform);
    }
  }

  runnerMeshes.forEach(r => {
    applyUniformToPlayer(r, battingUniform);
  });
}

function applyUniformToPlayer(playerGroup, uniform) {
  playerGroup.traverse(child => {
    if (child.isMesh && child.userData && child.userData.part) {
      const part = child.userData.part;
      let colorHex = uniform.jersey;

      if (part === 'jersey') colorHex = uniform.jersey;
      else if (part === 'pants') colorHex = uniform.pants;
      else if (part === 'cap') colorHex = uniform.cap;
      else if (part === 'visor') colorHex = uniform.visor;
      else if (part === 'sleeve') colorHex = uniform.sleeve;
      else if (part === 'belt') colorHex = uniform.belt;
      else if (part === 'socks') colorHex = uniform.socks || uniform.sleeve;
      else if (part === 'catcher') colorHex = uniform.cap;

      child.material = new THREE.MeshStandardMaterial({
        color: colorHex,
        roughness: part === 'catcher' ? 0.4 : 0.7
      });
    }
  });
}

function resetBallTrail() {
  ballTrailPoints = [];
  if (ballTrailLine) ballTrailLine.visible = false;
}

function addBallTrailPoint(pos) {
  if (!ballTrailLine) return;
  ballTrailPoints.push(pos.clone());
  if (ballTrailPoints.length > TRAIL_MAX_POINTS) {
    ballTrailPoints.shift();
  }
  const positions = ballTrailLine.geometry.attributes.position.array;
  for (let i = 0; i < TRAIL_MAX_POINTS; i++) {
    const pt = ballTrailPoints[i] || (ballTrailPoints.length > 0 ? ballTrailPoints[ballTrailPoints.length - 1] : pos);
    positions[i * 3] = pt.x;
    positions[i * 3 + 1] = pt.y;
    positions[i * 3 + 2] = pt.z;
  }
  ballTrailLine.geometry.attributes.position.needsUpdate = true;
  ballTrailLine.visible = ballTrailPoints.length > 1;
}

